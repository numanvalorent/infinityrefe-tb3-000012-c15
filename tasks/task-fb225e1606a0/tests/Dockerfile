# Verifier image (Terminal-Bench 3, [verifier] environment_mode = "separate").
# Generated by Infinity. The agent never sees this image; it is built from
# tests/ alone and receives only the declared artifacts under /app.
FROM public.ecr.aws/docker/library/python:3.13-slim-bookworm@sha256:01f42367a0a94ad4bc17111776fd66e3500c1d87c15bbd6055b7371d39c124fb

COPY wheels /opt/tbench-public-test-wheels
RUN cd /opt/tbench-public-test-wheels \
 && sha256sum -c SHA256SUMS \
 && pip install --no-cache-dir --no-index --find-links=. pytest==9.1.1 pytest-json-ctrf==0.5.2 \
 && rm -rf /opt/tbench-public-test-wheels

# Every artifact parent must exist before Harbor copies the artifacts in, or the
# trial errors instead of scoring. /logs/verifier is where the reward is written.
RUN mkdir -p /app /logs/verifier

COPY . /tests/
WORKDIR /tests
